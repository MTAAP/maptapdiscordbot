# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
GUILD_ID=your_server_id_here
CHANNEL_ID=channel_to_monitor_here

# Optional: separate channel for daily summaries (defaults to CHANNEL_ID)
# SUMMARY_CHANNEL_ID=channel_for_summaries

# Timezone for daily summary (default: Europe/Amsterdam)
TIMEZONE=Europe/Amsterdam

# Hour to post daily summary (0-23, default: 0 = midnight)
SUMMARY_HOUR=0

# SQLite database path (default: ./maptap.db; Coolify mounts /data)
DATABASE_PATH=./maptap.db

# Optional: SVPG Inference Gateway key to enable the daily blind visual local-smart player
# SVPG_API_KEY=your_svpg_gateway_key_here
# SVPG_BASE_URL=https://inference.svpg.dev/v1
# LLM_PLAYER_MODEL=local-smart
# LLM_REASONING_EFFORT=low
# LLM_RUN_DELAY_MINUTES=5
# CHROME_PATH=/usr/bin/chromium
